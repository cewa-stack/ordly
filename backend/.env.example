# ============================================
# APLIKACJA - USTAWIENIA OGÓLNE
# ============================================
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# ============================================
# MARKETPLACE - WYBÓR AKTYWNEGO PLUGINU
# ============================================
# Nazwa musi odpowiadać nazwie folderu w infrastructure/plugins/
MARKETPLACE_PROVIDER=allegro

# ============================================
# ALLEGRO - OAuth2 + PKCE
# ============================================
ALLEGRO_CLIENT_ID=twoj_client_id
ALLEGRO_CLIENT_SECRET=twoj_client_secret
ALLEGRO_ENVIRONMENT=production
# Adres przekierowania musi być zarejestrowany dokładnie tak w panelu Allegro
ALLEGRO_REDIRECT_URI=http://localhost:53682/auth/callback
ALLEGRO_TOKEN_ENCRYPTION_KEY=wygeneruj_losowy_klucz_32_bajty

# ============================================
# TELEGRAM (bot: ORDLY)
# ============================================
TELEGRAM_BOT_TOKEN=twoj_token_bota
TELEGRAM_ADMIN_CHAT_ID=123456789

# ============================================
# BAZA DANYCH
# ============================================
DATABASE_URL=sqlite+aiosqlite:///./data/ordly.db
DATABASE_ECHO=false

# ============================================
# SCHEDULER
# ============================================
SYNC_ORDERS_INTERVAL_SECONDS=60
# Przypomnienie o niewysłanych zamówieniach (20:00) oraz nocne czyszczenie
# czatu (02:00) mają stałe godziny czasu Europe/Warsaw - nie wymagają zmiennych.

# ============================================
# SMS (powiadomienie klienta przy pakowaniu)
# ============================================
# Dostawca bramki SMS. "logging" = tryb testowy (loguje treść zamiast
# realnej wysyłki). Realną bramkę podłącza się nową implementacją
# SmsProvider i zmianą tej wartości (np. na "smsapi").
SMS_PROVIDER=logging
# Nazwa nadawcy widoczna na SMS u realnego operatora.
SMS_SENDER_NAME=ORDLY

# ============================================
# BACKUP
# ============================================
BACKUP_DIRECTORY=./backups
BACKUP_RETENTION_DAYS=30

# ============================================
# LOGOWANIE
# ============================================
LOG_DIRECTORY=./logs
LOG_ROTATION=10 MB
LOG_RETENTION_DAYS=14

# ============================================
# ORDLY API (aplikacja mobilna ORDLY Mobile)
# ============================================
# Token używany przez aplikację mobilną (nagłówek
# "Authorization: Bearer <token>"). Wygeneruj losowy ciąg, np.:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
ORDLY_API_TOKEN=wygeneruj_losowy_token
# 0.0.0.0 = nasłuch na wszystkich interfejsach (wymagane, aby telefon
# połączył się przez Tailscale/LAN - patrz docs/01_app.md, sekcja 4).
ORDLY_API_HOST=0.0.0.0
ORDLY_API_PORT=8000
# Login i hasło do ekranu logowania w ORDLY Mobile (zamiast wklejania
# ORDLY_API_TOKEN ręcznie - po zalogowaniu apka dostaje token automatycznie
# i pamięta go, opcjonalnie za Face ID/odciskiem palca). WAŻNE: domyślne
# admin/admin działa "z pudełka", ale ZMIEŃ je, zanim Twoje ORDLY będzie
# dostępne poza zaufaną siecią (Tailscale/LAN).
ORDLY_ADMIN_USERNAME=admin
ORDLY_ADMIN_PASSWORD=admin
# Opcjonalne: ścieżka do zbudowanej wersji ORDLY Mobile
# (`npx expo export -p web` w mobile/) - gdy ustawiona, backend serwuje
# całą aplikację pod `/` (ten sam port co API). Puste = backend serwuje
# wyłącznie API, tak jak dotychczas. Patrz docs/01_app.md §6.5.
WEB_APP_DIST_PATH=

# ============================================
# WEB PUSH (drugi kanał powiadomień - ORDLY Mobile jako PWA, patrz
# docs/01_app.md sekcja Web Push - myślany głównie pod iPhone'a, gdzie
# natywny push wymaga płatnego konta Apple Developer)
# ============================================
# Puste wartości = Web Push wyłączony (jedynym kanałem zostaje Telegram).
# Wygeneruj parę kluczy poleceniem:
# uv run python -c "
# from py_vapid import Vapid02
# import base64
# v = Vapid02(); v.generate_keys()
# priv = v.private_key.private_numbers().private_value.to_bytes(32, 'big')
# print('VAPID_PRIVATE_KEY=' + base64.urlsafe_b64encode(priv).decode().rstrip('='))
# from cryptography.hazmat.primitives.serialization import Encoding, PublicFormat
# pub = v.public_key.public_bytes(Encoding.X962, PublicFormat.UncompressedPoint)
# print('VAPID_PUBLIC_KEY=' + base64.urlsafe_b64encode(pub).decode().rstrip('='))
# "
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Adres kontaktowy wymagany przez specyfikację VAPID (nie musi być realną skrzynką).
VAPID_CLAIM_EMAIL=mailto:admin@example.com

# ============================================
# SMTP (mail do hurtowni - przycisk "Zamów u hurtowni" w apce desktopowej)
# ============================================
# Puste wartości = wysyłka maili wyłączona (endpoint zwróci czytelny błąd
# zamiast próby połączenia z pustym hostem). Dla Gmaila: włącz weryfikację
# dwuetapową na koncie Google, potem wygeneruj "hasło aplikacji"
# (myaccount.google.com -> Bezpieczeństwo -> Hasła aplikacji) - zwykłe
# hasło do konta Google TUTAJ NIE ZADZIAŁA.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=twoj_adres@gmail.com
SMTP_PASS=haslo_aplikacji_16_znakow
# true = SSL/TLS od razu na porcie (zwykle 465), false = STARTTLS (zwykle 587).
SMTP_USE_SSL=false

# ============================================
# IMAP (Skrzynka - maile Allegro/OLX widoczne w apce desktopowej)
# ============================================
# Puste wartości = obserwator skrzynki wyłączony. To samo hasło aplikacji
# Gmaila co przy SMTP powyżej działa też tutaj (2FA musi być włączone).
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=twoj_adres@gmail.com
IMAP_PASS=haslo_aplikacji_16_znakow
# Fragmenty nagłówka "From:" do obserwowania (po przecinku). IMAP dopasowuje
# PODCIĄG, więc krótki token łapie wszystkie warianty adresu - "allegro"
# złapie i allegro.pl, i noreply@allegromail.pl, i powiadomienia@allegromail.pl,
# i powiadomienia@allegrolokalnie.pl.
# Nie wpisuj tu "allegro.pl": ten wariant NIE pasuje ani do allegromail.pl,
# ani do allegrolokalnie.pl - a to z nich Allegro faktycznie wysyła
# powiadomienia. Allegro Lokalnie nie ma API, więc te maile są JEDYNYM
# źródłem wiedzy o tamtejszej sprzedaży: zły token = brak powiadomień.
MAIL_WATCH_SENDERS=allegro,olx
# Fragmenty adresów, które mają NIE trafiać do skrzynki, mimo że przechodzą
# przez MAIL_WATCH_SENDERS. Ceną szerokiego dopasowania powyżej jest to, że
# "olx" łapie też powiadomienia@marketing.olx.pl ("Wow - 70% rabatu"), a
# "allegro" - hello@newsletter.allegro.pl ("Odbierz kupon"). Zwężanie
# MAIL_WATCH_SENDERS odcięłoby prawdziwych nadawców, więc marketing odsiewamy
# tutaj. Maile od tych nadawców nie są w ogóle zapisywane do bazy.
# Puste = nic nie jest wykluczane.
MAIL_EXCLUDE_SENDERS=marketing.olx.pl,newsletter.allegro.pl

# ============================================
# ORDLAK - generator ofert AI (Anthropic API)
# ============================================
# WAŻNE: to NIE jest subskrypcja Claude Pro/Claude Code - osobny klucz
# API z billingiem per-użycie, wygenerowany na console.anthropic.com.
# Bez tego klucza ekran Ordlak zwróci czytelny błąd zamiast próby wywołania AI.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Maks. rozmiar pojedynczego zdjęcia wysyłanego do AI (większe są odrzucane
# z czytelnym błędem zamiast próby wysyłki).
ORDLAK_MAX_PHOTO_SIZE_MB=5
