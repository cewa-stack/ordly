# Środowisko i sekrety
.env
.env.local
.env.*.local
*.pem
*.key

# Python (backend/)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.uv/
*.egg-info/
.eggs/

# Baza danych (nie commitujemy danych produkcyjnych)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backend/data/*.db
backend/backups/*.db

# Logi
*.log
backend/logs/

# Narzędzia jakości kodu / cache (Python)
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Node (desktop/, mobile/)
node_modules/
npm-debug.log*

# Build/dist (desktop, mobile, backend)
dist/
build/
out/
.expo/
web-build/

# ...ale `desktop/build/` to NIE jest katalog wynikowy, tylko zasoby
# potrzebne do zbudowania instalatora (ikona aplikacji). Bez tego
# `npm run dist` po swiezym sklonowaniu repo wywala sie na braku ikony.
!desktop/build/
!desktop/build/**

# Gotowe instalatory .exe - powstaja lokalnie, nie trafiaja do repo
desktop/release/

# Docker (lokalne override'y, jeśli powstaną)
docker-compose.override.yml

# IDE
.vscode/
.idea/
*.swp
*.swo

# System
.DS_Store
Thumbs.db
.claude/
